# --- Чувствительные данные: не коммитить никогда ---
# Обратный словарь деанонимизации. Позволяет восстановить
# реальные номера чертежей и программ из обезличенного датасета.
# Хранится вне репозитория, здесь — на случай возврата копии в папку.
anonymization_mapping.json

# Датасет управляющих программ и карт наладки.
# Обезличен, но в репозиторий не выкладывается.
cnc_finnpower/

# ПО стойки станка и его рабочие базы. Чужой дистрибутив плюс, возможно,
# незаобезличенные производственные данные. В репозиторий не попадает.
FP/

# Локальные черновики и материалы, не входящие в проект
_archive/
_private/

# --- Сборка ---
# app.spec отслеживается: в нём параметры сборки. Игнорируются только
# .spec, которые PyInstaller генерирует сам.
build/
dist/
*.exe

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Окружение и IDE ---
.env
.idea/
.vscode/
